# Base URL for the backend API used by src/services/api.ts.
#
# Leave this unset in local development: the Vite dev server proxies `/api` to
# http://127.0.0.1:8000 (see vite.config.ts), which avoids any CORS friction.
# Set it only when the frontend and backend are served from different origins.
# VITE_API_BASE_URL=http://localhost:8000/api
