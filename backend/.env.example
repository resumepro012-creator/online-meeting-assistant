# -----------------------------------------------------------------------------
# Copy this file to `backend/.env` and edit as needed. Never commit real secrets.
#   copy .env.example .env
# -----------------------------------------------------------------------------

# --- App ---
APP_NAME="AI Online Class Assistant API"
API_PREFIX=/api
LOG_LEVEL=INFO
# JSON array of allowed browser origins for local dev
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ---
# SQLite is the default (file is created automatically on first start).
DATABASE_URL=sqlite:///./data/app.db
# Example PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aiclass

# --- Auth ---
# CHANGE THIS. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Institute email policy ---
# Domains explicitly allowed to register or sign in. Comma-separated (a JSON
# array also works). Sub-domains of an approved domain are accepted
# automatically, so `uog.edu.pk` also permits `cs.uog.edu.pk`.
UNIVERSITY_EMAIL_DOMAINS=uog.edu.pk
# When true (the default) ANY institutional address is also accepted — `.edu`,
# `.edu.pk`, `.ac.uk`, and so on — while personal providers (gmail.com,
# outlook.com, yahoo.com, ...) stay refused. Set to false to allow ONLY the
# domains listed above.
ACCEPT_ANY_ACADEMIC_DOMAIN=true
# Development-only exceptions (the seeded demo account uses example.com).
# Leave this EMPTY in a real deployment.
DEV_ALLOWED_EMAIL_DOMAINS=example.com

# --- Email verification / password reset ---
# A 6-digit code is emailed; the account stays inactive until it is confirmed.
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30
# Used to build the password-reset link that is emailed.
PUBLIC_APP_URL=http://localhost:5173

# --- Email delivery ---
# console -> the verification code / reset link is printed to the backend log.
#            DEVELOPMENT ONLY, and it makes the API echo the code back so the
#            flow can be finished without a mail server.
# smtp    -> really sent through the SMTP server below. Use this in production;
#            the code is then never returned by the API.
EMAIL_BACKEND=console
# --- SMTP settings (only used when EMAIL_BACKEND=smtp) ---
# Never commit real credentials — set them in backend/.env, which is git-ignored,
# or in your deployment's secret store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@uog.edu.pk
SMTP_FROM_NAME="AI Online Class Assistant"
SMTP_USE_STARTTLS=true
# Implicit TLS (SMTPS), typically on port 465. Leave false for STARTTLS/587.
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=200

# --- ML pipeline ---
# auto = use the real model if its library is installed, otherwise fall back to
# the built-in baseline and say so in the API response. Allowed: auto | real | baseline
STT_BACKEND=auto
# Whisper size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
SEGMENT_CLASSIFIER_BACKEND=auto
SUMMARIZER_BACKEND=auto
# Optional: where Hugging Face weights get cached (defaults to ~/.cache/huggingface)
# HF_HOME=
